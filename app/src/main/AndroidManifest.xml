<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Band-leader mode runs entirely on the local network: mDNS to find the
      session, a TCP socket to follow it. No traffic leaves the room, which is
      why there is no INTERNET-only fallback and no server anywhere.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Bluetooth foot switches pair as HID keyboards and their key events arrive
      through the ordinary input path, so the app needs no Bluetooth permission
      to read them. CONNECT is declared only so the settings screen can name the
      pedal that is paired; it is requested when that screen is opened and the
      app works without it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Installing an update the user asked for. Since Android 8 this is granted
      per app rather than by one global "unknown sources" switch, and it cannot
      be requested with a runtime dialog - declaring it only makes the app
      eligible to appear in that Settings page, which the updater links to.

      Nothing is ever downloaded without somebody pressing a button, and the
      install itself is Android's own, with its own confirmation. See
      org.droidmusic.app.update.Updater.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Scanning music with the camera goes through an ACTION_IMAGE_CAPTURE
      intent, so the picture is taken by the camera app and this one needs no
      CAMERA permission of its own. The <queries> entry is what lets this app
      ask whether such an app exists before offering the button; without it,
      package visibility on Android 11 and later hides the answer.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".DroidMusicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidMusic"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DroidMusic"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a file the user tapped somewhere else: a chart in a file
              manager, a set list attached to an email.

              The schemes are declared explicitly, and that is not decoration.
              An intent filter with a VIEW action and no scheme reads as a web
              link with no URL - lint says so, and it is right, because without
              one this filter claims every VIEW of those MIME types including
              http ones the app cannot open. DroidMusic handles exactly two:
              content:// from a document provider, and file:// from local
              storage.

              No BROWSABLE category either. That category means "a browser may
              hand this to you", which is not how a chart or a set list ever
              arrives here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/json" />
                <!--
                  A Word chart tapped in a file manager. Spelled out rather than
                  covered by a wildcard, because "application/*" would claim
                  every installer, archive and unknown blob on the device and
                  then fail to open most of them.
                -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <!--
                  Every text chart, not only text/plain. A chart written by
                  another app can arrive as text/markdown or text/x-chordpro
                  depending on who is doing the telling, and all of them are
                  characters this app can read.
                -->
                <data android:mimeType="text/*" />
                <!--
                  And the type a ChordPro file actually arrives as.

                  ChordPro has no registered MIME type. Android's own table has
                  never heard of .cho, .chopro, .crd or .pro, so every provider
                  on the device falls back to application/octet-stream - which
                  is why, without this line, a chart made in another app cannot
                  be opened from a file manager at all and the system says the
                  file is not supported.

                  It is a wider claim than the rest of this filter, and it is
                  narrower than it looks: octet-stream is the "no idea" type, so
                  archives, installers and media all have their own and none of
                  them land here. What does land is unknown files, where being
                  one entry in a chooser the user picks from is the correct
                  amount of presumption. Anything that turns out not to be a
                  chart is refused by name rather than silently ignored - see
                  DocumentSources.kindOfPickedFile.
                -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!--
              A chart or a set list arriving through another app's share sheet.

              Separate from the filter above because a SEND carries its payload
              in EXTRA_STREAM rather than in the intent's data URI, so matching
              on a scheme would reject every share. SEND matches on type alone.

              This is how a chart written on a laptop or in another editor
              usually crosses over: not through a file manager, but by being
              shared. Accepting only set lists here meant DroidMusic did not
              appear in that share sheet at all.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/pdf" />
                <!--
                  Two quite different shares arrive as text, and the app wants
                  both. One is a chart *file* shared as text/plain, which comes
                  with its bytes in EXTRA_STREAM. The other is a chart *page*
                  shared out of a browser, which has no file at all - only
                  EXTRA_TEXT holding the page title and its address. The second
                  is how a chart found on a phone gets into the library without
                  anybody typing it out; see LibraryController.importFromShare.
                -->
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          Sharing an exported set list out to other apps. Read-only, scoped to a
          single cache directory, which is all a share needs.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
