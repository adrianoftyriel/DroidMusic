<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Band-leader mode runs entirely on the local network: mDNS to find the
      session, a TCP socket to follow it. No traffic leaves the room, which is
      why there is no INTERNET-only fallback and no server anywhere.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Bluetooth foot switches pair as HID keyboards and their key events arrive
      through the ordinary input path, so the app needs no Bluetooth permission
      to read them. CONNECT is declared only so the settings screen can name the
      pedal that is paired; it is requested when that screen is opened and the
      app works without it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".DroidMusicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidMusic"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DroidMusic"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Opening a file the user tapped somewhere else: a chart in a file
              manager, a set list attached to an email.

              The schemes are declared explicitly, and that is not decoration.
              An intent filter with a VIEW action and no scheme reads as a web
              link with no URL - lint says so, and it is right, because without
              one this filter claims every VIEW of those MIME types including
              http ones the app cannot open. DroidMusic handles exactly two:
              content:// from a document provider, and file:// from local
              storage.

              No BROWSABLE category either. That category means "a browser may
              hand this to you", which is not how a chart or a set list ever
              arrives here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <!--
              A set list arriving through another app's share sheet.

              Separate from the filter above because a SEND carries its payload
              in EXTRA_STREAM rather than in the intent's data URI, so matching
              on a scheme would reject every share. SEND matches on type alone.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!--
          Sharing an exported set list out to other apps. Read-only, scoped to a
          single cache directory, which is all a share needs.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
