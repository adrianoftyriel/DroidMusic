<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the export staging directory is ever shared out. -->
    <cache-path name="exports" path="exports/" />

    <!--
      A downloaded update, handed to the system installer. The installer is
      another app, so a file:// URI to it has thrown FileUriExposedException
      since Android 7 and a provider is the only way to pass it across.
    -->
    <cache-path name="updates" path="updates/" />
</paths>
